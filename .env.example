# ── OpenAI (obligatorio) ──────────────────────────────────────────────────────
# Plantilla única: copiar a .env, .env.dev o .env.prod y completar los valores.
# Para separar entornos Docker, ver docs/BASE_DESPLIEGUE.md.
OPENAI_API_KEY=sk-...

# ── Modelos de texto y proveedor por función ─────────────────────────────────
# Valores admitidos: openai / bedrock. OpenAI mantiene el comportamiento actual.
# Los agentes ya usan el adaptador. Antes de activar bedrock, preparar acceso,
# permisos IAM y credenciales AWS en el entorno de ejecución.
# Con bedrock, indicar explícitamente el ID de modelo o perfil de inferencia.
PROVEEDOR_RAZONAMIENTO=openai
PROVEEDOR_REDACCION=openai
AWS_REGION=eu-west-1
# MODELO_RAZONAMIENTO — IdentificadorCR: tareas de razonamiento normativo
# MODELO_REDACCION    — Redactores + RAG: generación de texto técnico
# MODELO_EMBEDDING    — ChromaDB: vectorización de fichas CR
# La validación de CR utiliza el mismo proveedor y modelo que razonamiento.
# Embeddings permanecen en OpenAI: OPENAI_API_KEY sigue siendo obligatoria.
# IMPORTANTE: si cambias MODELO_EMBEDDING hay que re-indexar la base vectorial
MODELO_RAZONAMIENTO=gpt-4o
MODELO_REDACCION=gpt-4o-mini
MODELO_EMBEDDING=text-embedding-3-small

# ── LangSmith (opcional — trazabilidad de agentes) ────────────────────────────
# Déjalo en false si no usas LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=reformas-vehiculos
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Docker Compose ──────────────────────────────────────────────────────────
# Defaults para .env. Si usas otro archivo, ajustar APP_ENV_FILE y las rutas.
APP_ENV_FILE=.env
COMPOSE_PROJECT_NAME=homologaciones
CHROMA_HOST_PATH=./scripts_index/chroma_db
OUTPUT_HOST_PATH=./outputs
CADDY_CONFIG_PATH=./deploy/caddy
FRONTEND_PORT=8501
# Opcionales: vacíos para construir localmente; URI completa con etiqueta o digest
# para descargar imágenes publicadas. Con ECR usar pull y up --no-build.
BACKEND_IMAGE=
FRONTEND_IMAGE=
# Solo necesario para publicar con compose.public.yml; introducir el dominio.
PUBLIC_DOMAIN=
